
name: Check UFC3 private assets

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  check-assets:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout project
        uses: actions/checkout@v4

      - name: Checkout private game assets
        uses: actions/checkout@v4
        with:
          repository: databvse/ufc3-private-assets
          token: ${{ secrets.ASSETS_TOKEN }}
          path: private-assets

      - name: Verify game file
        run: |
          test -f private-assets/default.xex
          echo "Private game file found."
          stat -c "File size: %s bytes" private-assets/default.xex
